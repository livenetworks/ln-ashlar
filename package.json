{
  "name": "@livenetworks/ashlar",
  "version": "1.6.1",
  "description": "LiveNetworks unified frontend library - CSS framework and vanilla JS components",
  "license": "MIT",
  "author": "Live Networks",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/livenetworks/ln-ashlar.git"
  },
  "homepage": "https://github.com/livenetworks/ln-ashlar#readme",
  "bugs": "https://github.com/livenetworks/ln-ashlar/issues",
  "keywords": [
    "css",
    "scss",
    "design-system",
    "frontend",
    "components",
    "vanilla-js"
  ],
  "files": [
    "scss/",
    "js/"
  ],
  "exports": {
    "./scss/*": "./scss/*",
    "./js/*": "./js/*"
  },
  "scripts": {
    "test": "npm run sync:ln-schemas:check && node --test \"tests/*.test.js\"",
    "test:p0": "node --test tests/p0-data-integrity.test.js",
    "dev": "node scripts/build.mjs --watch",
    "build": "npm run sync:ln-schemas && node scripts/build.mjs && npm run build:dev-css && npm run build:demos",
    "build:demos": "npm run build:demo-index && npm run build:demo-admin && npm run build:demo-docuflow && npm run build:demo-spa",
    "build:dev-css": "sass scss/ln-ashlar-dev.scss demo/dist/ln-ashlar-dev.css --no-source-map --style=compressed",
    "build:demo-index": "sass demo/index.scss demo/index.css --no-source-map --style=compressed",
    "build:demo-admin": "sass demo/admin/src/admin.scss demo/admin/dist/admin.css --no-source-map --style=compressed && node -e \"const fs = require('fs'); fs.copyFileSync('demo/admin/src/demo.js', 'demo/admin/dist/demo.js')\" && node demo/admin/src/build-pages.mjs",
    "build:demo-docuflow": "sass demo/docuflow/docuflow.scss demo/docuflow/dist/docuflow.css --no-source-map --style=compressed",
    "build:demo-spa": "node demo/spa/build.mjs",
    "sync:ln-schemas": "node scripts/sync-ln-schemas.mjs",
    "sync:ln-schemas:check": "node scripts/sync-ln-schemas.mjs --check"
  },
  "devDependencies": {
    "@tabler/icons": "^3.41.1",
    "fake-indexeddb": "^6.2.4",
    "flag-icons": "^7.5.0",
    "puppeteer-core": "^25.1.0",
    "sass-embedded": "^1.83.0",
    "vite": "^6.0.0"
  }
}
