	<!-- Individual Attribute Definitions with Types and Restrictions -->
	<xs:attribute name="data-ln-accordion" type="xs:string">
		<xs:annotation>
			<xs:documentation>Identifies container as an accordion that coordinates single-panel expansion</xs:documentation>
		</xs:annotation>
	</xs:attribute>

	<xs:attribute name="data-ln-ajax" type="xs:string">
		<xs:annotation>
			<xs:documentation>Enables AJAX interception of form submissions and anchor clicks within container</xs:documentation>
		</xs:annotation>
	</xs:attribute>

	<xs:attribute name="data-ln-api-base-url" type="xs:string">
		<xs:annotation>
			<xs:documentation>Base URL endpoint for API requests</xs:documentation>
		</xs:annotation>
	</xs:attribute>

	<xs:attribute name="data-ln-api-connector" type="xs:string">
		<xs:annotation>
			<xs:documentation>Mounts API connector bridging REST backend and ln-ashlar data coordinators</xs:documentation>
		</xs:annotation>
	</xs:attribute>

	<xs:attribute name="data-ln-api-connector-query-debounce">
		<xs:annotation>
			<xs:documentation>Debounce delay in milliseconds before dispatching query requests</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:integer">
				<xs:minInclusive value="0"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:attribute>

	<xs:attribute name="data-ln-api-headers" type="xs:string">
		<xs:annotation>
			<xs:documentation>Custom HTTP headers in JSON format or semicolon-separated pairs</xs:documentation>
		</xs:annotation>
	</xs:attribute>

	<xs:attribute name="data-ln-api-param-limit" type="xs:string">
		<xs:annotation>
			<xs:documentation>Query parameter name for pagination page size</xs:documentation>
		</xs:annotation>
	</xs:attribute>

	<xs:attribute name="data-ln-api-param-offset" type="xs:string">
		<xs:annotation>
			<xs:documentation>Query parameter name for pagination offset</xs:documentation>
		</xs:annotation>
	</xs:attribute>

	<xs:attribute name="data-ln-api-param-search" type="xs:string">
		<xs:annotation>
			<xs:documentation>Query parameter name for text search filter</xs:documentation>
		</xs:annotation>
	</xs:attribute>

	<xs:attribute name="data-ln-api-param-sort-dir" type="xs:string">
		<xs:annotation>
			<xs:documentation>Query parameter name for sort direction</xs:documentation>
		</xs:annotation>
	</xs:attribute>

	<xs:attribute name="data-ln-api-param-sort-field" type="xs:string">
		<xs:annotation>
			<xs:documentation>Query parameter name for sort field</xs:documentation>
		</xs:annotation>
	</xs:attribute>

	<xs:attribute name="data-ln-api-path" type="xs:string">
		<xs:annotation>
			<xs:documentation>Resource path appended to base URL</xs:documentation>
		</xs:annotation>
	</xs:attribute>

	<xs:attribute name="data-ln-api-queue" type="xs:string">
		<xs:annotation>
			<xs:documentation>Mounts offline API synchronization queue backed by IndexedDB</xs:documentation>
		</xs:annotation>
	</xs:attribute>

	<xs:attribute name="data-ln-api-queue-online">
		<xs:annotation>
			<xs:documentation>Network connectivity override (true/false, or auto-detect from navigator.onLine)</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="false"/>
				<xs:enumeration value="true"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:attribute>

	<xs:attribute name="data-ln-attr" type="xs:string">
		<xs:annotation>
			<xs:documentation>data-ln-attr attribute</xs:documentation>
		</xs:annotation>
	</xs:attribute>

	<xs:attribute name="data-ln-autoresize" type="xs:string">
		<xs:annotation>
			<xs:documentation>Automatically adjusts textarea height to match its scrollable content</xs:documentation>
		</xs:annotation>
	</xs:attribute>

	<xs:attribute name="data-ln-autosave" type="xs:string">
		<xs:annotation>
			<xs:documentation>Form autosave storage key identifier</xs:documentation>
		</xs:annotation>
	</xs:attribute>

	<xs:attribute name="data-ln-autosave-clear" type="xs:string">
		<xs:annotation>
			<xs:documentation>Designates a button that clears saved form data from localStorage</xs:documentation>
		</xs:annotation>
	</xs:attribute>

	<xs:attribute name="data-ln-autosave-debounce-input">
		<xs:annotation>
			<xs:documentation>Debounce delay in milliseconds before saving on input events</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:integer">
				<xs:minInclusive value="0"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:attribute>

	<xs:attribute name="data-ln-autosave-exclude" type="xs:string">
		<xs:annotation>
			<xs:documentation>Excludes form control from autosave serialization</xs:documentation>
		</xs:annotation>
	</xs:attribute>

	<xs:attribute name="data-ln-chart" type="xs:string">
		<xs:annotation>
			<xs:documentation>Chart instance name or identifier</xs:documentation>
		</xs:annotation>
	</xs:attribute>

	<xs:attribute name="data-ln-chart-area" type="xs:string">
		<xs:annotation>
			<xs:documentation>data-ln-chart-area attribute</xs:documentation>
		</xs:annotation>
	</xs:attribute>

	<xs:attribute name="data-ln-chart-count" type="xs:string">
		<xs:annotation>
			<xs:documentation>data-ln-chart-count attribute</xs:documentation>
		</xs:annotation>
	</xs:attribute>

	<xs:attribute name="data-ln-chart-empty" type="xs:string">
		<xs:annotation>
			<xs:documentation>data-ln-chart-empty attribute</xs:documentation>
		</xs:annotation>
	</xs:attribute>

	<xs:attribute name="data-ln-chart-labels" type="xs:string">
		<xs:annotation>
			<xs:documentation>data-ln-chart-labels attribute</xs:documentation>
		</xs:annotation>
	</xs:attribute>

	<xs:attribute name="data-ln-chart-line" type="xs:string">
		<xs:annotation>
			<xs:documentation>data-ln-chart-line attribute</xs:documentation>
		</xs:annotation>
	</xs:attribute>

	<xs:attribute name="data-ln-chart-max" type="xs:string">
		<xs:annotation>
			<xs:documentation>data-ln-chart-max attribute</xs:documentation>
		</xs:annotation>
	</xs:attribute>

	<xs:attribute name="data-ln-chart-min" type="xs:string">
		<xs:annotation>
			<xs:documentation>data-ln-chart-min attribute</xs:documentation>
		</xs:annotation>
	</xs:attribute>

	<xs:attribute name="data-ln-chart-padding">
		<xs:annotation>
			<xs:documentation>Internal plot padding in pixels</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:integer">
				<xs:minInclusive value="0"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:attribute>

	<xs:attribute name="data-ln-chart-plot" type="xs:string">
		<xs:annotation>
			<xs:documentation>data-ln-chart-plot attribute</xs:documentation>
		</xs:annotation>
	</xs:attribute>

	<xs:attribute name="data-ln-chart-sort" type="xs:string">
		<xs:annotation>
			<xs:documentation>Field name to sort chart series data by</xs:documentation>
		</xs:annotation>
	</xs:attribute>

	<xs:attribute name="data-ln-chart-source" type="xs:string">
		<xs:annotation>
			<xs:documentation>Source store or coordinator identifier</xs:documentation>
		</xs:annotation>
	</xs:attribute>

	<xs:attribute name="data-ln-chart-type">
		<xs:annotation>
